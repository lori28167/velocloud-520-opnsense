#!/usr/bin/env bash
# Registra la console seriale del VeloCloud (COM2 via mini-USB, 115200) in tools/con.log.
# Una sola copia alla volta, e niente picocom in parallelo (si dividerebbero i byte).
D="$(cd "$(dirname "$0")" && pwd)"
stty -F /dev/ttyUSB0 115200 cs8 -cstopb -parenb -crtscts -ixon -ixoff clocal raw -echo -echoe -echok -echoctl -echoke
exec cat /dev/ttyUSB0 >> "$D/con.log"
